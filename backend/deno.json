{
  "imports": {
    "oak": "https://deno.land/x/oak@v17.1.6/mod.ts",
    "cors": "https://deno.land/x/cors@v1.2.2/mod.ts",
    "djwt": "https://deno.land/x/djwt@v3.0.2/mod.ts",
    "postgres": "jsr:@db/postgres",
    "redis": "https://deno.land/x/redis@v0.29.0/mod.ts",
    "zod": "npm:zod@4.4.3",
    "bcrypt": "https://deno.land/x/bcrypt@v0.4.1/mod.ts",
    "client-s3": "npm:@aws-sdk/client-s3@^3.600.0",
    "s3-request-presigner": "npm:@aws-sdk/s3-request-presigner@^3.600.0",
    "s3-presigned-post": "npm:@aws-sdk/s3-presigned-post@^3.600.0",
    "nanoid": "npm:nanoid@5.1.11",
    "dockerode": "npm:dockerode@3.3.0",
    "tar-stream": "npm:tar-stream@^3.1.7",
    "fflate": "npm:fflate@^0.8.2",
    "app/": "./src/"
  },
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env --allow-sys --allow-read src/back_server.ts 3000",
    "start": "deno run --allow-net --allow-env --allow-sys --allow-read src/back_server.ts 3000",
    "db:migrate": "deno run --allow-net --allow-env --allow-sys --allow-read=migrations src/Commands/runMigrations.ts",
    "user:create-admin": "deno run --allow-net --allow-env --allow-sys src/Commands/createAdmin.ts",
    "db:populate": "deno run --allow-net --allow-env src/Commands/populateDB.ts",
    "db:prune": "deno run --allow-net --allow-env src/Commands/pruneDB.ts",
    "db:setup-dev": "deno task db:migrate && deno task db:populate",
    "worker:start": "deno run --allow-net --allow-env --allow-sys --allow-read --allow-write --allow-run src/worker_manager.ts",
    "test": "DENO_ENV=test deno test --env=.env.test --allow-net --allow-env --allow-read",
    "test:ci": "DENO_ENV=test deno test --env=.env.test --allow-net --allow-env --allow-read --junit-path=$JUNIT_PATH"
  }
}
