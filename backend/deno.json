{
  "imports": {
    "oak": "https://deno.land/x/oak@v17.1.6/mod.ts",
    "cors": "https://deno.land/x/cors@v1.2.2/mod.ts",
    "djwt": "https://deno.land/x/djwt@v3.0.2/mod.ts",
    "postgres": "jsr:@db/postgres",
    "redis": "https://deno.land/x/redis@v0.29.0/mod.ts",
    "zod": "npm:zod@4.4.3",
    "bcrypt": "https://deno.land/x/bcrypt@v0.4.1/mod.ts",
    "client-s3": "npm:@aws-sdk/client-s3@^3.600.0",
    "s3-request-presigner": "npm:@aws-sdk/s3-request-presigner@^3.600.0",
    "nanoid": "npm:nanoid@5.1.11"
  },
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env src/back_server.ts 3000",
    "start": "deno run --allow-net --allow-env src/back_server.ts 3000",
    "db:migrate": "deno run --allow-net --allow-env --allow-read=migrations src/Commands/runMigrations.ts",
    "db:populate": "deno run --allow-net --allow-env src/Commands/populateDB.ts",
    "db:setup-dev": "deno task db:migrate && deno task db:populate",
    "user:create-admin": "deno run --allow-net --allow-env src/Commands/createAdmin.ts"
  }
}
