# --- DATABASE (Postgres) ---
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=mydatabase
DB_HOST=db
DB_PORT=5432

# --- REDIS (Sessions) ---
REDIS_PASSWORD=mypassword

# --- MinIO ---
MINIO_USER=myuser
MINIO_PASSWORD=mypassword
MINIO_STORAGE_BUCKET_NAME=raydams

# --- API (Deno) ---
# Secret pour la génération/validation des tokens JWT
JWT_SECRET=un_secret_tres_long_et_aleatoire_ici
# Liste des domaines autorisés (CORS) - Ex: Ex: http://localhost:5173,http://localhost:8080
ALLOWED_ORIGINS=http://localhost:5173
# Secret pour le hash des mots de passe (Poivre)
PEPPER_SECRET=un_autre_secret_tres_long_et_aleatoire_ici

# --- AUTHENTICATION & COOKIES ---
# Durée de vie en secondes (Ex: 900 = 15 minutes)
ACCESS_TOKEN_LIFETIME=900
# Durée de vie en secondes (Ex: 604800 = 7 jours)
REFRESH_TOKEN_LIFETIME=604800
# true en production (HTTPS), false en développement (HTTP)
COOKIE_SECURE=false
# Valeurs autorisées : lax, strict, none
COOKIE_SAMESITE=lax

# --- WORKER & COMPILER CONFIGURATION ---
# Nombre maximum de builds simultanés sur le worker
MAX_CONCURRENT=2
# Temps maximum alloué à un build avant d'être tué (en millisecondes - ex: 300000 = 5 minutes)
BUILD_TIMEOUT_MS=300000

# --- FRONTEND ---
# URL de l'API (Deno) appelée par le frontend
API_URL=http://localhost:3000

# --- MinIO public URL (utilisée par les services pour accéder à MinIO depuis l'extérieur)
# Exemple en dev : http://localhost:9000
PUBLIC_S3_ENDPOINT=http://localhost:9000
