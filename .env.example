# --- DATABASE (Postgres) ---
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=mydatabase

# --- API (Deno) ---
# Secret pour la génération/validation des tokens JWT
JWT_SECRET=un_secret_tres_long_et_aleatoire_ici

# Liste des domaines autorisés et séparés par des virgules (CORS) - Ex: http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000